# Copy to `client/InkstoneInterface/.env.local` for local dev (`npm run dev`).
# In docker-compose these are passed via `environment:` (NOT build-args).
#
# BFF migration: the upstream bearer token never enters the browser.
# All bridge / coach traffic is proxied through Next.js API routes
# under /api/{bridge,coach,dashboard}, which read the secrets below
# server-side. See docs/refactoring/refactoring_guide.md C3/C4.

# ── Server-side secrets (REQUIRED) ─────────────────────────────────
# Shared secret with the state-bridge and Go coach. Generate with:
#   openssl rand -hex 16
STATE_BRIDGE_TOKEN=

# Random per-deployment value (>=32 bytes) used to HMAC the
# inkstone_session cookie. Generate with:
#   openssl rand -hex 32
BFF_SESSION_SECRET=

# ── Server-side internal URLs ──────────────────────────────────────
# Reachable from inside the docker network. The browser never sees these.
STATE_BRIDGE_INTERNAL_URL=http://state-bridge:5003
COACH_INTERNAL_URL=http://go-coaching:8080

# ── Browser-visible (URL-only, NO secrets) ─────────────────────────
# Optional WS origin override. Defaults to `${pageProtocol}://${hostname}:5003`.
# NEXT_PUBLIC_BRIDGE_WS_ORIGIN=ws://localhost:5003

# Optional: explicit engine WS URL when bypassing the bridge relay.
# NEXT_PUBLIC_ENGINE_WS_URL=ws://localhost:8080/ws

# Optional: turn off bridge command relay and talk to the engine directly.
# NEXT_PUBLIC_USE_BRIDGE_COMMANDS=false

# Optional: browser TTS provider selection.
# `browser` keeps using window.speechSynthesis.
# `fish_modal` calls the Go coaching proxy at /api/dashboard/tts.
# In Docker/production we prefer `fish_modal` and fall back to browser only
# when the upstream TTS request fails.
NEXT_PUBLIC_TTS_PROVIDER=fish_modal

# Optional: fallback provider when the primary TTS call fails.
NEXT_PUBLIC_TTS_FALLBACK_PROVIDER=browser
